# Keep the build context small and the image clean. Mirrors .gitignore plus
# the build outputs we regenerate inside the image.
.git/
.venv/
__pycache__/
*.pyc
*.pyo
.DS_Store
.env
.env.*

# Rebuilt inside the image (stage 1) — never copy a host build in.
client/dist/
client/node_modules/
node_modules/

# Desktop/freeze + electron outputs — not part of the container.
build/
dist/
release/
*.spec.bak

# Local data / DB — never bake into the image.
db.sqlite3
data/
jobs/

# Tests + docs aren't needed at runtime (kept small; remove if you want them).
**/__pycache__/
.pytest_cache/
